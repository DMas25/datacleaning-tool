# ColtraDataAi — secrets template
#
# This file IS committed so the required structure is documented.
# .streamlit/secrets.toml itself is gitignored and must be created
# locally / in each Codespace / in Streamlit Cloud's Secrets settings —
# it is never pushed to GitHub.
#
# To set this up in a GitHub Codespace:
#   1. Open a terminal in the Codespace
#   2. cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   3. Edit .streamlit/secrets.toml and set your real password
#
# To set this up on Streamlit Cloud:
#   App settings → Advanced settings → Secrets → paste the contents
#   of your local .streamlit/secrets.toml

[credentials]
password = "changeme"

# ── Developer / testing ────────────────────────────────────────────────────
# Set testing_mode = true to reveal the "Dev: override tier" dropdown in the
# sidebar so you can test Pro / Enterprise features without a real licence key.
# NEVER set this to true in production.
[dev]
testing_mode = false
# Set local_dev = true on your own machine to run fully unlocked without a licence key.
# NEVER set this to true in Streamlit Cloud secrets.
local_dev = false
